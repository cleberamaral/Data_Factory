							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"notebookPath": "/Users/cleberson.ricardo@gmail.com/Bronze"
						},
						"linkedServiceName": {
							"referenceName": "Databricks_Demo_Cluster",
							"type": "LinkedServiceReference"
						}
					},
