						"name": "Silver - Fact",
						"type": "DatabricksNotebook",
						"dependsOn": [
							{
								"activity": "Silver - Dimensions",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"notebookPath": "/Users/cleberson.ricardo@gmail.com/Silver - Fact"
						},
						"linkedServiceName": {
							"referenceName": "Databricks_Demo_Cluster",
