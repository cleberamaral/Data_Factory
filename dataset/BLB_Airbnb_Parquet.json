{
	"name": "BLB_Airbnb_Parquet",
	"properties": {
		"linkedServiceName": {
			"referenceName": "AzureDataLakeStorage1",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"filename": {
				"type": "string"
			}
		},
		"annotations": [],
		"type": "Parquet",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"fileName": {
					"value": "@{concat(dataset().filename,'.parquet')}",
					"type": "Expression"
				},
				"folderPath": "parquet",
				"fileSystem": "airbnb"
			},
			"compressionCodec": "snappy"
		},
		"schema": []
	}
}